CREATE OR REPLACE PROCEDURE proc_Grade AS
BEGIN
    FOR student IN (
        SELECT roll_no, name, total_marks
        FROM Stud_Marks
    ) LOOP
        IF student.total_marks BETWEEN 990 AND 1500 THEN
            INSERT INTO Result (roll_no, name, class)
            VALUES (student.roll_no, student.name, 'Distinction');

        ELSIF student.total_marks BETWEEN 900 AND 989 THEN
            INSERT INTO Result (roll_no, name, class)
            VALUES (student.roll_no, student.name, 'First Class');

        ELSIF student.total_marks BETWEEN 825 AND 899 THEN
            INSERT INTO Result (roll_no, name, class)
            VALUES (student.roll_no, student.name, 'Higher Second Class');
        END IF;
    END LOOP;
END;
/

BEGIN
    proc_Grade;
END;
/

