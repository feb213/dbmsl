-- Q1. Rename assets column to Property
ALTER TABLE Branch
RENAME COLUMN assets TO Property;


-- Q2. Find loan numbers from Akurdi branch
-- where loan amount is greater than 12000
SELECT loan_no
FROM Loan
WHERE branch_name = 'Akurdi'
  AND amount > 12000;


-- Q3. Find average account balance at each branch
SELECT branch_name,
       AVG(balance) AS average_balance
FROM Account
GROUP BY branch_name;


-- Q4. Find branches with average balance greater than 12000
SELECT branch_name,
       AVG(balance) AS average_balance
FROM Account
GROUP BY branch_name
HAVING AVG(balance) > 12000;


-- Q5. Count the number of customers
SELECT COUNT(*) AS total_customers
FROM Customer;


-- Q6. Calculate total loan amount given by the bank
SELECT SUM(amount) AS total_loan_amount
FROM Loan;


-- Q7. Delete loans with amounts between 1300 and 1500
DELETE FROM Loan
WHERE amount BETWEEN 1300 AND 1500;


-- Q8. Find customers whose street address is unavailable
SELECT cust_name
FROM Customer
WHERE cust_street IS NULL;


-- Q9. Find branches where branch city is available
SELECT branch_name, branch_city
FROM Branch
WHERE branch_city IS NOT NULL;


-- Q10. Find customers whose names start with A
SELECT cust_name
FROM Customer
WHERE cust_name LIKE 'A%';
