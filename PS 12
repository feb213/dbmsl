db.employee.insertMany([
    { empid: 1, ename: "dinesh", dept: "comp", salary: 45000 },
    { empid: 2, ename: "Atharv", dept: "IT", salary: 35000 },
    { empid: 3, ename: "Arnav", dept: "comp", salary: 40000 },
    { empid: 4, ename: "OM", dept: "Mech", salary: 28000 },
    { empid: 5, ename: "deepak", dept: "IT", salary: 32000 }
])


db.employee.find()

db.employee.find({ dept: "comp" })

db.employee.find({
    $or: [
        { dept: "comp" },
        { dept: "IT" }
    ]
})


db.employee.find({ salary: { $gt: 30000 } })


db.employee.find({
    salary: { $gte: 40000 },
    dept: "comp"
})



db.employee.find({
    salary: { $gte: 20000, $lte: 40000 }
})


db.employee.find({ dept: { $ne: "IT" } })

db.employee.aggregate([
    {
        $group: {
            _id: "$dept",
            total_salary: { $sum: "$salary" }
        }
    }
])


db.employee.aggregate([
    {
        $group: {
            _id: "$dept",
            avg_salary: { $avg: "$salary" }
        }
    }
])


