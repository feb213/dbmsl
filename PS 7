CREATE OR REPLACE TRIGGER trg_library_audit
BEFORE UPDATE OR DELETE ON Library
FOR EACH ROW
BEGIN
    IF DELETING THEN
        INSERT INTO Library_Audit
            (book_id, book_name, author, category, book_date, operation)
        VALUES
            (:OLD.book_id, :OLD.book_name, :OLD.author,
             :OLD.category, :OLD.book_date, 'DELETE');

    ELSIF UPDATING THEN
        INSERT INTO Library_Audit
            (book_id, book_name, author, category, book_date, operation)
        VALUES
            (:OLD.book_id, :OLD.book_name, :OLD.author,
             :OLD.category, :OLD.book_date, 'UPDATE');
    END IF;
END;
/

