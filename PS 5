CREATE TABLE areas (
    radius NUMBER,
    area NUMBER
);

CREATE OR REPLACE FUNCTION circle_area(r NUMBER)
RETURN NUMBER
IS
    a NUMBER;
BEGIN
    a := 3.14 * r * r;
    RETURN a;
END;
/

BEGIN
    FOR i IN 5..9
    LOOP
        INSERT INTO areas (radius, area)
        VALUES (i, circle_area(i));
    END LOOP;
END;
/

SELECT * FROM areas;
