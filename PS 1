1. Display all customers alphabetically by name
SELECT *
FROM Customer
ORDER BY cust_name ASC;


2. Display names and cities of customers whose names start with P
SELECT cust_name, city
FROM Customer
WHERE cust_name LIKE 'P%';


3. Customers who live in Pune or Mumbai and have a phone number
SELECT *
FROM Customer
WHERE city IN ('Pune', 'Mumbai')
  AND phone IS NOT NULL;


4. Display customers whose phone number is NULL
SELECT *
FROM Customer
WHERE phone IS NULL;


5. Average account balance for each branch
SELECT
    B.branch_name,
    AVG(A.balance) AS avg_balance
FROM Branch B
INNER JOIN Account A
    ON B.branch_id = A.branch_id
GROUP BY B.branch_id, B.branch_name;


6. Branch-wise average balance greater than ₹40,000
SELECT
    B.branch_name,
    AVG(A.balance) AS avg_balance
FROM Branch B
INNER JOIN Account A
    ON B.branch_id = A.branch_id
GROUP BY B.branch_id, B.branch_name
HAVING AVG(A.balance) > 40000;


7. Account number and balance after adding 10% interest
SELECT
    acc_no,
    balance,
    balance * 1.10 AS balance_with_interest
FROM Account;


