use Student

db.student.insertMany([
    { roll_no: 1, sname: "Dinesh", dept: "Computer", marks: 85 },
    { roll_no: 2, sname: "Atharv", dept: "IT", marks: 72 },
    { roll_no: 3, sname: "Arnav", dept: "Computer", marks: 91 },
    { roll_no: 4, sname: "Om", dept: "Mechanical", marks: 35 },
    { roll_no: 5, sname: "Deepak", dept: "IT", marks: 65 }
])

db.student.find()

db.student.find({ dept: "Computer" })

db.student.find({
    $or: [
        { dept: "Computer" },
        { dept: "IT" }
    ]
})

db.student.find({ marks: { $gt: 70 } })


db.student.find({
    marks: { $gte: 80 },
    dept: "Computer"
})

db.student.find({
    $or: [
        { marks: { $lt: 40 } },
        { dept: "IT" }
    ]
})


db.student.find({
    marks: {
        $gte: 40,
        $lte: 80
    }
})



db.student.find({ dept: { $ne: "IT" } })


db.student.aggregate([
    {
        $group: {
            _id: "$dept",
            total_marks: { $sum: "$marks" }
        }
    }
])


db.student.createIndex({ sname: 1 })

db.student.dropIndex({ sname: 1 })

