Q1. Display customers living in Pune or Mumbai alphabetically
SELECT *
FROM Customer
WHERE city IN ('Pune', 'Mumbai')
ORDER BY cust_name ASC;


Q2. Display customers whose names contain 'a'
SELECT *
FROM Customer
WHERE cust_name LIKE '%a%';


Q3. Display customers whose phone number is NOT NULL
SELECT *
FROM Customer
WHERE phone IS NOT NULL;


Q4. Display customers living in Pune whose names start with P, or customers living in Mumbai
SELECT *
FROM Customer
WHERE (city = 'Pune' AND cust_name LIKE 'P%')
   OR city = 'Mumbai';


Q5. Display maximum and average loan amount for each branch
SELECT B.branch_name,
       MAX(L.amount) AS maximum_loan,
       AVG(L.amount) AS average_loan
FROM Branch B
JOIN Loan L ON B.branch_id = L.branch_id
GROUP BY B.branch_name;


Q6. Display branches whose total loan amount exceeds ₹1,00,000
SELECT B.branch_name,
       SUM(L.amount) AS total_loan
FROM Branch B
JOIN Loan L ON B.branch_id = L.branch_id
GROUP BY B.branch_name
HAVING SUM(L.amount) > 100000;


Q7. Display account numbers with balance after adding ₹500
SELECT acc_no,
       balance + 500 AS updated_balance
FROM Account;


Q8. Change the branch of account number 2005
UPDATE Account
SET branch_id = 4
WHERE acc_no = 2005;


Q9. Delete customers whose phone number is NULL
DELETE FROM Customer
WHERE phone IS NULL;



