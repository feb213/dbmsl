-- =========================================
-- QUERY 1
-- Display student names with course and marks
-- =========================================

SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id;


-- =========================================
-- QUERY 2
-- Display all students and their enrolment info,
-- including students without enrolments
-- =========================================

SELECT S.name, E.course, E.marks
FROM Students S
LEFT JOIN Enrolments E
    ON S.student_id = E.student_id;


-- =========================================
-- QUERY 3
-- Display all enrolments with student names
-- =========================================

SELECT E.enroll_id, S.name, E.course, E.marks
FROM Enrolments E
LEFT JOIN Students S
    ON E.student_id = S.student_id;


-- =========================================
-- QUERY 4
-- Display all possible combinations of students
-- and distinct courses
-- =========================================

SELECT S.name, C.course
FROM Students S
CROSS JOIN (
    SELECT DISTINCT course
    FROM Enrolments
) C;


-- =========================================
-- QUERY 5
-- Display students whose marks are above
-- the average marks of all enrolments
-- =========================================

SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id
WHERE E.marks > (
    SELECT AVG(marks)
    FROM Enrolments
);


-- =========================================
-- QUERY 6
-- Display students who scored more than 80
-- =========================================

SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id
WHERE E.marks > 80;


-- =========================================
-- QUERY 7
-- Display students enrolled in DBMS
-- =========================================

SELECT S.name
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id
WHERE E.course = 'DBMS';


-- =========================================
-- QUERY 8
-- Display student ID(s) with the highest marks
-- =========================================

SELECT student_id
FROM Enrolments
WHERE marks = (
    SELECT MAX(marks)
    FROM Enrolments
);


-- =========================================
-- QUERY 9
-- Create, display, and update a view
-- =========================================

CREATE VIEW student_course_view AS
SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id;

-- Display the view
SELECT * FROM student_course_view;

-- Update marks through the view
UPDATE student_course_view
SET marks = 89
WHERE name = 'Dinesh'
  AND course = 'DBMS';

-- Verify the update
SELECT * FROM student_course_view
WHERE name = 'Dinesh';


