SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id;



SELECT S.name, E.course, E.marks
FROM Students S
LEFT JOIN Enrolments E
    ON S.student_id = E.student_id;



SELECT E.enroll_id, S.name, E.course, E.marks
FROM Enrolments E
LEFT JOIN Students S
    ON E.student_id = S.student_id;



SELECT S.name, C.course
FROM Students S
CROSS JOIN (
    SELECT DISTINCT course
    FROM Enrolments
) C;



SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id
WHERE E.marks > (
    SELECT AVG(marks)
    FROM Enrolments
);

SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id
WHERE E.marks > 80;



SELECT S.name
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id
WHERE E.course = 'DBMS';



SELECT student_id
FROM Enrolments
WHERE marks = (
    SELECT MAX(marks)
    FROM Enrolments
);




CREATE VIEW student_course_view AS
SELECT S.name, E.course, E.marks
FROM Students S
INNER JOIN Enrolments E
    ON S.student_id = E.student_id;


SELECT * FROM student_course_view;


