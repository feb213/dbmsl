

CREATE DATABASE PS2_DB;
USE PS2_DB;


CREATE TABLE Students (
    student_id INT PRIMARY KEY,
    name VARCHAR(50) NOT NULL,
    city VARCHAR(50)
);


CREATE TABLE Enrolments (
    enroll_id INT PRIMARY KEY,
    student_id INT,
    course VARCHAR(50),
    marks INT,
    FOREIGN KEY (student_id)
        REFERENCES Students(student_id)
);

