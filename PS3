-- QUERY 1
SELECT S.name, E.course
FROM Students S
JOIN Enrolments E
ON S.student_id = E.student_id;


-- QUERY 2
SELECT S.name, E.*
FROM Students S
LEFT JOIN Enrolments E
ON S.student_id = E.student_id;


-- QUERY 3
SELECT S.name, E.course, E.marks
FROM Students S
JOIN Enrolments E
ON S.student_id = E.student_id
WHERE E.course = 'DBMS';


-- QUERY 4
SELECT E.enroll_id, S.name
FROM Enrolments E
LEFT JOIN Students S
ON S.student_id = E.student_id;


-- QUERY 5
SELECT E.*, S.name
FROM Students S
JOIN Enrolments E
ON S.student_id = E.student_id
WHERE marks < (
    SELECT AVG(marks)
    FROM Enrolments E
);


-- QUERY 6
SELECT E.marks, S.name
FROM Students S
JOIN Enrolments E
ON S.student_id = E.student_id
WHERE marks = (
    SELECT MAX(marks)
    FROM Enrolments E
);


-- QUERY 7
SELECT name, city
FROM Students
WHERE city = 'Pune';


-- QUERY 8
SELECT S.name
FROM Students S
JOIN Enrolments E
ON S.student_id = E.student_id
WHERE E.course = 'Python';


-- QUERY 9
CREATE VIEW course_average_view AS
SELECT course, AVG(marks) AS avg_marks
FROM Enrolments
GROUP BY course;

SELECT * FROM course_average_view;


-- QUERY 10
CREATE INDEX idx_student_city
ON Students(city);

CREATE UNIQUE INDEX idx_student_id
ON Students(student_id);

